//store-images.s-microsoft.com/image/apps.48261.13993220746278015.0e048b86-a58f-494b-9460-6eb91a47eec3.58225244-f919-4e60-af90-c61af69cdda7","Width":3840},{"FileId":"3019460634731035352","EISListingIdentifier":null,"BackgroundColor":"","Caption":null,"FileSizeInBytes":7600690,"ForegroundColor":"","Height":2160,"ImagePositionInfo":"Desktop/16","ImagePurpose":"Screenshot","UnscaledImageSHA256Hash":"SmWdGrwcL/rSmEtChjQqAz3BVbxUkIOBpr4bdYYkRQE=","Uri":"//store-images.s-microsoft.com/image/apps.25930.13993220746278015.0e048b86-a58f-494b-9460-6eb91a47eec3.5a2cf605-ca3e-45f6-86e7-0f0943da75e2","Width":3840},{"FileId":"3039587016888221916","EISListingIdentifier":null,"BackgroundColor":"","Caption":null,"FileSizeInBytes":8980033,"ForegroundColor":"","Height":2160,"ImagePositionInfo":"Desktop/17","ImagePurpose":"Screenshot","UnscaledImageSHA256Hash":"PnHUGVPvenUXPmvjMbqinJbWMPTPp6TT+YC5P0BMY7M=","Uri":"//store-images.s-microsoft.com/image/apps.28990.13993220746278015.0e048b86-a58f-494b-9460-6eb91a47eec3.a9a95639-cf21-4a75-a8ef-0be1d1a7e6b3","Width":3840}],"Videos":[],"ProductDescription":"Take team-building to new heights in Teamfight Tactics, the multiplayer PvP auto battler from the studio behind League of Legends.\n\nBust out the big-brain strats as you draft, position, and adapt on the fly in 8-player free-for-all auto battles. With hundreds of team combinations and meta that never sits still, wild strategies can win big… if your team manages to outlast everyone else.\n\nA NEW WORLD EVERY SET\nThe TFT Convergence is an ever-evolving dimension of imagination made manifest. That means completely new themes and mechanics with every new set! \nFrom magical academies to kaiju-infested cities and pulse-pounding music festivals, there’s always an exciting new world to battle in.\n\nROLL WITH THE CHAOS\nDraft a dream team of champions from a shared multiplayer pool, where bold picks, last-second pivots, and sudden serendipity can reshape the battlefield. Clash round after round to be the last Tactician standing, using creativity and cunning to turn unpredictable drafts and game-changing events into winning tactics.\n\nBRING YOUR FRIENDS\nChallenge your friends and stir up rivalries across PC, Mac, and mobile. Queue up together and see whose brilliant schemes (or lucky breaks) take them to the top.\n\nRISE UP THE RANKS\nFull competitive support and PvP matchmaking mean there’s always a worthy opponent ready to put your comp to the test. Take those top-tier strategies all the way from Iron to Challenger, and claim exclusive Ranked rewards at the end of every set!\n\nSTYLE ON ‘EM\nFlaunt your favorite Little Legend on the battlefield, defeat foes with a flourish using booms and finishers, and fashionably traverse realms with portals. Play your way to fresh new looks from the Pass or Pass+, or by purchasing them in the TFT store.\n\nDownload and play Teamfight Tactics today!","ProductTitle":"Teamfight Tactics","ShortTitle":"","SortTitle":"","FriendlyTitle":null,"ShortDescription":"Draft and deploy an army of champions in TFT, the League of Legends auto battler.\n\nWith Game Pass, members will unlock:\n●        1-Star Rare Little Legend Tacticians \n●        4 Arena Skins that are available until December 2026 and 1 Arena Skin on a monthly rotation thereafter","SearchTitles":[{"SearchTitleString":"TeamFight Tactics","SearchTitleType":"SearchHint"},{"SearchTitleString":"Riot Games","SearchTitleType":"SearchHint"},{"SearchTitleString":"TFT","SearchTitleType":"SearchHint"},{"SearchTitleString":"Auto-Battle","SearchTitleType":"SearchHint"},{"SearchTitleString":"Auto battler","SearchTitleType":"SearchHint"},{"SearchTitleString":"Strategy Game","SearchTitleType":"SearchHint"},{"SearchTitleString":"Chess","SearchTitleType":"SearchHint"}],"VoiceTitle":"","RenderGroupDetails":null,"ProductDisplayRanks":[],"InteractiveModelConfig":null,"Interactive3DEnabled":false,"Language":"en","Markets":["US","DZ","AR","AU","AT","BH","BD","BE","BR","BG","CA","CL","CN",