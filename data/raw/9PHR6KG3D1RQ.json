re-images.s-microsoft.com/image/apps.7363.71050925055292780.d113598c-97ad-4805-8dbc-eb73bf447e25.398cd259-7129-4e55-a162-8e2bcc483ef8","Width":3840},{"FileId":"3003402938730577661","EISListingIdentifier":{"ListingId":"3000000000000000001","AssetId":"1152922700025690607"},"BackgroundColor":"#FFFFFF","Caption":"","FileSizeInBytes":1416063,"ForegroundColor":"#FFFFFF","Height":1080,"ImagePositionInfo":"Xbox/7","ImagePurpose":"Screenshot","UnscaledImageSHA256Hash":"MWGxO+ONBWlZnyD9PkZhxqW2zE7K+gOwRqb45gRNQ8c=","Uri":"//store-images.s-microsoft.com/image/apps.24881.71050925055292780.d113598c-97ad-4805-8dbc-eb73bf447e25.ccaf39f6-c325-4c81-88a1-096e17a97f85","Width":1920}],"Videos":[],"ProductDescription":"Defend and rebuild Washington, D.C. after a devastating pandemic in this tactical open world third-person shooter:\n\nTACTICAL COMBAT\nEngage enemies in intense, cover-based firefights where tactical positioning and utility usage make the difference between life and death.\n\nBUILD THE ULTIMATE AGENT\nLoot and craft cutting-edge gear and learn powerful skills to customize the way you fight. Take things further with Specializations, with roles like the long-range marksman, the demolition expert, the survivalist leader, and more.\n\nTEAMWORK SAVES LIVES\nTeam up with up to three other agents for tactical co-op missions where synergy matters. Combine Specializations, share resources, and take on dynamic challenges that scale with your squad.\n\nSURVIVE EVER-EVOLVING WASHINGTON, D.C.\nFrom tense firefights in changing weather to the constant push and pull of factions warring over map control, the city reacts, adapts, and challenges you to survive with every move you make.\n\nVISCERAL ENDGAME\nReaching max level is just the start. Dive into high-stakes endgame missions, intense PvP battles, and dynamic world events that push your skills and teamwork to the limit. Every season brings fresh rewards and fierce challenges.\n\nInternet connection, Ubisoft account, Microsoft Account and Game Pass Ultimate or Core (subscriptions sold separately) required to access online multiplayer/features.","ProductTitle":"Tom Clancy’s The Division 2","ShortTitle":"The Division 2","SortTitle":"Tom Clancy’s The Division 2","FriendlyTitle":null,"ShortDescription":"Join The Division in this open world tactical shooter. Engage in intense cover-based combat, team up with friends, and build your ultimate agent to save Washington, D.C.","SearchTitles":[],"VoiceTitle":"","RenderGroupDetails":null,"ProductDisplayRanks":[],"InteractiveModelConfig":null,"Interactive3DEnabled":false,"Language":"en","Markets":["US","DZ","AR","AU","AT","BH","BD","BE","BR","BG","CA","CL","CN","CO","CR","HR","CY","CZ","DK","EG","EE","FI","FR","DE","GR","GT","HK","HU","IS","IN","ID","IQ","IE","IL","IT","JP","JO","KZ","KE","KW","LV","LB","LI","LT","LU","MY","MT","MR","MX","MA","NL","NZ","NG","NO","OM","PK","PE","PH","PL","PT","QA","RO","RU","SA","RS","SG","SK","SI","ZA","KR","ES","SE","CH","TW","TH","TT","TN","TR","UA","AE","GB","VN","YE","LY","LK","UY","VE","AF","AX","AL","AS","AO","AI","AQ","AG","AM","AW","BO","BQ","BA","BW","BV","IO","BN","BF","BI","KH","CM","CV","KY","CF","TD","TL","DJ","DM","DO","EC","SV","GQ","ER","ET","FK","FO","FJ","GF","PF","TF","GA","GM","GE","GH","GI","GL","GD","GP","GU","GG","GN","GW","GY","HT","HM","HN","AZ","BS","BB","BY","BZ","BJ","BM","BT","KM","CG","CD","CK","CX","CC","CI","CW","JM","SJ","JE","KI","KG","LA","LS","LR","MO","MK","MG","MW","IM","MH","MQ","MU","YT","FM","MD","MN","MS","MZ","MM","NA","NR","NP","MV","ML","NC","NI","NE","NU","NF","PW","PS","PA","PG","PY","RE","RW","BL","MF","WS","ST","SN","MP","PN","SX","SB","SO","SC","SL","GS","SH","KN","LC","PM","VC","TJ","TZ","TG","TK","TO","TM","TC","TV","UM","UG","VI","VG","WF","EH","ZM","ZW","UZ","VU","SR","SZ","AD","MC","SM","ME","VA","NEUTRAL"]}],"MarketProperties":[{"OriginalReleaseDate":"2026-07-21T14:00:00.0000000Z","MinimumUserAge":18,"ContentRatings":[{"RatingSystem":"ESRB","RatingId":"ESRB:M","RatingDe