 Castle Wolfenstein. Use dual-wielding metal pipes to navigate the world with brand new wall-climbing abilities.\r\n\r\nThe Terror!\r\nGo up against a new cast of vicious villains and enemies, including legions of hulking new Super Soldiers, elite shock troops, drones and the Regime’s darkest and most terrifying creations yet.","SkuTitle":"Wolfenstein: The Old Blood (PC)","SkuButtonTitle":"","DeliveryDateOverlay":null,"SkuDisplayRank":[],"TextResources":null,"Images":[],"LegalText":{"AdditionalLicenseTerms":"","Copyright":"© 2015 - 2021 Bethesda Softworks LLC, a ZeniMax Media company. ","CopyrightUri":"","PrivacyPolicy":"","PrivacyPolicyUri":"https://bethesda.net/document/privacy-policy","Tou":"","TouUri":""},"Language":"en","Markets":["US","DZ","AR","AU","BH","BD","BE","BR","BG","CA","CL","CN","CO","CR","HR","CY","CZ","DK","EG","EE","FI","FR","GR","GT","HK","HU","IS","IN","ID","IQ","IE","IL","IT","JO","KZ","KE","KW","LV","LB","LI","LT","LU","MY","MT","MR","MX","MA","NL","NZ","NG","NO","OM","PK","PE","PH","PL","PT","QA","RO","RU","SA","RS","SG","SK","SI","ZA","KR","ES","SE","TW","TH","TT","TN","TR","UA","AE","GB","VN","YE","LY","LK","UY","VE","AF","AX","AL","AS","AO","AI","AQ","AG","AM","AW","BO","BQ","BA","BW","BV","IO","BN","BF","BI","KH","CM","CV","KY","CF","TD","TL","DJ","DM","DO","EC","SV","GQ","ER","ET","FK","FO","FJ","GF","PF","TF","GA","GM","GE","GH","GI","GL","GD","GP","GU","GG","GN","GW","GY","HT","HM","HN","AZ","BS","BB","BY","BZ","BJ","BM","BT","KM","CG","CD","CK","CX","CC","CI","CW","JM","SJ","JE","KI","KG","LA","LS","LR","MO","MK","MG","MW","IM","MH","MQ","MU","YT","FM","MD","MN","MS","MZ","MM","NA","NR","NP","MV","ML","NC","NI","NE","NU","NF","PW","PS","PA","PG","PY","RE","RW","BL","MF","WS","ST","SN","MP","PN","SX","SB","SO","SC","SL","GS","SH","KN","LC","PM","VC","TJ","TZ","TG","TK","TO","TM","TC","TV","UM","UG","VI","VG","WF","EH","ZM","ZW","UZ","VU","SR","SZ","AD","MC","SM","ME","VA","NEUTRAL","AT","DE","CH","JP"]}],"MarketProperties":[{"FirstAvai